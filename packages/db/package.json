{
  "name": "@hajj/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./tenant": "./src/tenant.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "studio": "drizzle-kit studio",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "seed:demo": "tsx --env-file=../../.env src/seed-demo.ts"
  },
  "devDependencies": {
    "@types/node": "22",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@hajj/core": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  }
}
