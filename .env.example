# Database: owner runs migrations, app role is used at runtime (RLS enforced)
DATABASE_OWNER_URL=postgres://hajj_owner:hajj_owner_dev@localhost:5440/hajj
DATABASE_URL=postgres://hajj_app:hajj_app_dev@localhost:5440/hajj

REDIS_URL=redis://localhost:6390

S3_ENDPOINT=http://localhost:9020
S3_REGION=us-east-1
S3_BUCKET=hajj-private
S3_ACCESS_KEY=hajj_storage
S3_SECRET_KEY=hajj_storage_dev_secret

# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3100

# 32-byte keys, base64. Used to encrypt passport numbers and build search indexes.
FIELD_ENCRYPTION_KEY=change-me
BLIND_INDEX_KEY=change-me

# Agency whose website is shown on the root domain (organization slug)
PUBLIC_TENANT_SLUG=demo

# Email (sign-in codes for new devices, password reset, security alerts).
# Production: ZeptoMail. Without either setting, new-device codes stay off.
# ZEPTOMAIL_TOKEN="Zoho-enczapikey ..."
# ZEPTOMAIL_FROM_ADDRESS=noreply@example.com
# ZEPTOMAIL_FROM_NAME=Hajj Tracking
# Local development and browser tests: write emails to files, readable at /dev/mail.
# Ignored unless BETTER_AUTH_URL is localhost, so it can never expose codes on a server.
MAIL_TRANSPORT=file
MAIL_OUTBOX_DIR=.mail-outbox

# SMS (payment texts, notices, mobile verification, password reset by SMS).
# Production: one Bangladeshi gateway. Without it, SMS stays off and messages are marked "not sent".
# SMS_PROVIDER=bulksmsbd        # or sslwireless, alphasms
# SMS_API_KEY=...
# SMS_SENDER_ID=...             # the approved sender ID / masking name
# Local development and browser tests: write SMS to the same outbox, shown at /dev/mail.
SMS_TRANSPORT=file
