{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_OWNER_URL",
    "DATABASE_POOL_SIZE",
    "REDIS_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "S3_*",
    "FIELD_ENCRYPTION_KEY",
    "BLIND_INDEX_KEY",
    "SMS_PROVIDER",
    "PUBLIC_TENANT_SLUG"
  ]
}
